generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Users & Auth
// ============================================================

model User {
  id            String   @id @default(uuid())
  username      String   @unique
  email         String?  @unique
  password_hash String?  // null for OAuth-only users
  public_key    String   // Ed25519 public key (hex)
  
  credits       Int      @default(200)   // Welcome bonus
  current_elo   Int      @default(1200)  // Starting ELO
  peak_elo      Int      @default(1200)
  total_matches Int      @default(0)
  wins          Int      @default(0)
  losses        Int      @default(0)
  draws         Int      @default(0)
  
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  // Relations
  bots          Bot[]
  inventory     UserInventory[]
  skills        UserSkill[]
  transactions  CreditTransaction[]
  oauth_accounts OAuthAccount[]
  
  @@map("users")
}

model OAuthAccount {
  id           String   @id @default(uuid())
  user_id      String
  provider     String   // 'google', 'github', etc.
  provider_id  String   // Provider's user ID
  email        String?
  
  created_at   DateTime @default(now())
  
  user         User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  
  @@unique([provider, provider_id])
  @@map("oauth_accounts")
}

// ============================================================
// Bots
// ============================================================

model Bot {
  id            String   @id @default(uuid())
  user_id       String
  name          String
  public_key    String?  // Bot-specific Ed25519 key (optional, falls back to user key)
  
  level         Int      @default(1)
  xp            Int      @default(0)
  
  base_hp       Int      @default(100)
  base_attack   Int      @default(15)
  base_defense  Int      @default(10)
  base_speed    Int      @default(10)
  
  skin_id       String?
  
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  
  // Relations
  user          User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  accessories   BotAccessory[]
  equipped_skills BotSkill[]
  matches_as_bot1 Match[] @relation("MatchBot1")
  matches_as_bot2 Match[] @relation("MatchBot2")
  matches_won     Match[] @relation("MatchWinner")
  
  @@map("bots")
}

model BotAccessory {
  id        String @id @default(uuid())
  bot_id    String
  item_id   String
  
  bot       Bot      @relation(fields: [bot_id], references: [id], onDelete: Cascade)
  item      ShopItem @relation(fields: [item_id], references: [id])
  
  @@unique([bot_id, item_id])
  @@map("bot_accessories")
}

model BotSkill {
  id        String @id @default(uuid())
  bot_id    String
  skill_id  String
  slot      Int    // 1 or 2
  
  bot       Bot   @relation(fields: [bot_id], references: [id], onDelete: Cascade)
  skill     Skill @relation(fields: [skill_id], references: [id])
  
  @@unique([bot_id, slot])
  @@map("bot_skills")
}

// ============================================================
// Shop & Items
// ============================================================

model ShopItem {
  id              String   @id @default(uuid())
  name            String
  description     String
  category        String   // 'skin', 'accessory', 'stat_boost', 'emote', 'effect'
  price           Int
  rarity          String   // 'common', 'rare', 'epic', 'legendary'
  
  hp_bonus        Int      @default(0)
  attack_bonus    Int      @default(0)
  defense_bonus   Int      @default(0)
  speed_bonus     Int      @default(0)
  
  preview_url     String?
  limited_edition Boolean  @default(false)
  stock_remaining Int?     // null = unlimited
  
  created_at      DateTime @default(now())
  
  // Relations
  inventory       UserInventory[]
  bot_accessories BotAccessory[]
  
  @@map("shop_items")
}

model UserInventory {
  id           String   @id @default(uuid())
  user_id      String
  item_id      String
  purchased_at DateTime @default(now())
  
  user         User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  item         ShopItem @relation(fields: [item_id], references: [id])
  
  @@unique([user_id, item_id])
  @@map("user_inventory")
}

// ============================================================
// Skills
// ============================================================

model Skill {
  id          String @id // e.g. 'fireball', 'shield_wall'
  name        String
  description String
  rarity      String // 'common', 'rare', 'epic', 'legendary'
  price       Int    // 0 for starter skills
  cooldown    Int    // rounds
  target      String // 'opponent' or 'self'
  
  // Skill effect data (JSON for flexibility)
  effect_data Json   // { damage: 20, status: 'burning', duration: 2, ... }
  
  // Relations
  owners      UserSkill[]
  equipped_on BotSkill[]
  
  @@map("skills")
}

model UserSkill {
  id        String   @id @default(uuid())
  user_id   String
  skill_id  String
  acquired_at DateTime @default(now())
  
  user      User  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  skill     Skill @relation(fields: [skill_id], references: [id])
  
  @@unique([user_id, skill_id])
  @@map("user_skills")
}

// ============================================================
// Matches
// ============================================================

model Match {
  id               String   @id @default(uuid())
  match_type       String   // 'ranked_bronze', 'ranked_silver', etc.
  
  bot1_id          String
  bot2_id          String
  winner_id        String?  // null = draw or in-progress
  
  bot1_elo_before  Int
  bot1_elo_after   Int?
  bot2_elo_before  Int
  bot2_elo_after   Int?
  
  rounds_fought    Int      @default(0)
  duration_seconds Int?
  
  entry_fee        Int
  winner_payout    Int?
  
  // Full replay stored as JSON
  replay           Json?    // RoundResult[]
  
  status           String   @default("pending") // 'pending', 'active', 'completed', 'cancelled'
  
  started_at       DateTime?
  completed_at     DateTime?
  created_at       DateTime @default(now())
  
  // Relations
  bot1             Bot      @relation("MatchBot1", fields: [bot1_id], references: [id])
  bot2             Bot      @relation("MatchBot2", fields: [bot2_id], references: [id])
  winner           Bot?     @relation("MatchWinner", fields: [winner_id], references: [id])
  
  @@map("matches")
}

// ============================================================
// Credit Transactions (Ledger)
// ============================================================

model CreditTransaction {
  id          String   @id @default(uuid())
  user_id     String
  amount      Int      // Positive = credit, negative = debit
  balance     Int      // Balance after this transaction
  reason      String   // 'welcome_bonus', 'match_entry', 'match_win', 'shop_purchase', 'admin_adjust'
  reference_id String? // Match ID, item ID, etc.
  
  created_at  DateTime @default(now())
  
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  
  @@index([user_id, created_at])
  @@map("credit_transactions")
}
